    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "fast-check": "3.23.2",
    "globals": "15.14.0",
    "playwright-core": "^1.49.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.6",
